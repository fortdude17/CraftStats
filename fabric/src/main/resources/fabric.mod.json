{
  "schemaVersion": 1,
  "id": "craftstats",
  "version": "${version}",
  "name": "CraftStats!",
  "description": "Universal in-game stats editor for mobs, blocks, items and players.",
  "authors": ["Fortdude21"],
  "contact": {
    "homepage": "https://github.com/fortdude17/CraftStats",
    "sources": "https://github.com/fortdude17/CraftStats",
    "issues": "https://github.com/fortdude17/CraftStats/issues"
  },
  "license": "MIT",
  "icon": "assets/craftstats/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.craftstats.fabric.CraftStatsFabric"],
    "client": ["com.craftstats.fabric.CraftStatsClientFabric"],
    "modmenu": ["com.craftstats.fabric.config.CraftStatsModMenuConfig"]
  },
  "mixins": [
    "craftstats-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "architectury": ">=${architectury_version}",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
